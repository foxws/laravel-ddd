{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "foxws/laravel-ddd",
  "description": "Domain Driven Design scaffolding for Laravel projects",
  "keywords": [
    "laravel",
    "foxws",
    "laravel-ddd",
    "ddd"
  ],
  "homepage": "https://github.com/foxws/laravel-ddd",
  "license": "MIT",
  "authors": [
    {
      "name": "foxws",
      "email": "francoism90@users.noreply.github.com",
      "role": "Developer"
    }
  ],
  "require": {
    "php": "^8.4",
    "illuminate/support": "^12.0||^13.0"
  },
  "require-dev": {
    "larastan/larastan": "^3.9",
    "laravel/pint": "^1.29",
    "laravel/pao": "^1.0",
    "orchestra/testbench": "^10.0||^11.0",
    "pestphp/pest": "^5.0",
    "pestphp/pest-plugin-laravel": "^5.0",
    "pestphp/pest-plugin-type-coverage": "^5.0.2",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "files": [
      "src/Helpers.php"
    ],
    "psr-4": {
      "Foxws\\Ddd\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Foxws\\Ddd\\Tests\\": "tests/",
      "Workbench\\App\\": "workbench/app/",
      "Workbench\\Database\\Factories\\": "workbench/database/factories/",
      "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@clear",
      "@prepare"
    ],
    "prepare": [
      "@php vendor/bin/testbench package:discover --ansi"
    ],
    "build": [
      "@php vendor/bin/testbench workbench:build --ansi"
    ],
    "serve": [
      "Composer\\Config::disableProcessTimeout",
      "@build",
      "@php vendor/bin/testbench serve --ansi"
    ],
    "lint": [
      "vendor/bin/pint --parallel"
    ],
    "lint:check": [
      "vendor/bin/pint --parallel --test"
    ],
    "analyse": [
      "vendor/bin/phpstan analyse"
    ],
    "test:types": [
      "vendor/bin/pest --type-coverage --min=100"
    ],
    "test:unit": [
      "vendor/bin/pest --parallel"
    ],
    "test": [
      "@analyse",
      "@lint:check",
      "@test:types",
      "@test:unit"
    ],
    "clear": [
      "@php vendor/bin/testbench package:purge-skeleton --ansi"
    ]
  },
  "extra": {
    "laravel": {
      "providers": [
        "Foxws\\Ddd\\DddServiceProvider"
      ]
    }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
