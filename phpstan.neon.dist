parameters:
    level: 7
    paths:
        - src
        - config
    tmpDir: build/phpstan
    configDirectories:
        - %currentWorkingDirectory%/config
    ignoreErrors:
        -
            # The event class name is guessed dynamically from a file path,
            # the same way Laravel's own default guesser works, so it can't
            # be statically proven to be a class-string.
            identifier: return.type
            path: src/Support/DddEventDiscovery.php
